# =============================================================================
# backend/.env.example — Backend environment variables
#
# Copy to .env for local development or Docker:
#   cp .env.example .env
#
# NEVER commit .env to Git.
# NEVER put real secrets in this file.
# =============================================================================

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# True for local development, False for production/Docker
DEBUG=True

# Comma-separated. Add your Render backend hostname in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Development (local postgres):
DB_NAME=accessslot_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Docker Compose — change DB_HOST to: db
# DB_HOST=db

# Production (Render) — these are injected automatically from the database service,
# no need to set them manually in the Render dashboard.

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Production — set to the actual frontend URL (Render static site or custom domain)
# CORS_ALLOWED_ORIGINS=https://accessslot-frontend.onrender.com

# ── Security (production only) ────────────────────────────────────────────────
# Set to False on Render since Render handles TLS termination at the proxy layer
SECURE_SSL_REDIRECT=False
