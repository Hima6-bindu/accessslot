# =============================================================================
# frontend/.env.example — Frontend environment variables
#
# Copy to .env for local development (not Docker):
#   cp .env.example .env
#
# NOTE: VITE_ variables are BUILD-TIME only.
# They are baked into the JS bundle by Vite at build time.
# Changing them after the build has no effect.
# =============================================================================

# ── Development (local npm run dev) ──────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api

# ── Docker local (docker compose up) ─────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8000/api

# ── Production (Render) ───────────────────────────────────────────────────────
# Set this as a build environment variable in the Render dashboard.
# VITE_API_BASE_URL=https://accessslot-backend.onrender.com/api
